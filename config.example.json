{
  "providers": {
    "order": ["metron", "comicvine"],
    "prefer": {},
    "cache_ttl": "24h"
  },
  "rename": {
    "template": "{Series}[ ({Year})] #{Number:3}"
  },
  "credentials": {
    "metron": {
      "username": "YOUR_METRON_USERNAME",
      "password_file": "~/.config/cbz/metron-password"
    },
    "comicvine": {
      "api_key_file": "~/.config/cbz/comicvine-api-key"
    }
  }
}
