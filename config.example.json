{
  "providers": {
    "order": ["metron", "comicvine"],
    "prefer": {},
    "cache_ttl": "24h"
  },
  "rename": {
    "template": "{Series} #{Number:3}[ - {Title}]",
    "on_tag": false
  },
  "credentials": {
    "metron": {
      "api_key_file": "~/.config/cbztool/metron-token"
    },
    "comicvine": {
      "api_key_file": "~/.config/cbztool/comicvine-api-key"
    }
  }
}
